# Этап сборки: образ с Go и инструментами Debian Bookworm.
# Имя builder позволит скопировать результат в финальный образ.
# Go 1.25 соответствует минимальной версии, указанной в go.mod.
FROM golang:1.25-bookworm AS builder

# Рабочая папка для последующих RUN и COPY.
WORKDIR /app

# Сначала копируем только описание зависимостей, чтобы Docker мог
# использовать кеш их загрузки, пока go.mod и go.sum не изменились.
COPY go.mod go.sum ./
RUN go mod download

# Копируем исходники из контекста сборки — корня проекта.
COPY . .

# Отключаем CGO и собираем бинарник без зависимости от системной libc.
# Так его можно запускать в Alpine, где используется другая libc.
RUN CGO_ENABLED=0 go build -o /app/cmd/todoapp/exe /app/cmd/todoapp

# Финальный этап: небольшой образ Alpine без компилятора и исходников.
FROM alpine:3.23

# Рабочая папка приложения в финальном образе.
WORKDIR /app

# Забираем из builder только готовый бинарник: он окажется в /app/exe.
COPY --from=builder /app/cmd/todoapp/exe /app

# При старте контейнера запускаем приложение напрямую, без оболочки.
CMD ["/app/exe"]
